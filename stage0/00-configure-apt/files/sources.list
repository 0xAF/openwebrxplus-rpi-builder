#deb-src http://raspbian.raspberrypi.com/raspbian/ RELEASE main contrib non-free rpi

deb [ arch=armhf ] http://deb.debian.org/debian RELEASE main contrib non-free non-free-firmware
deb [ arch=armhf ] http://deb.debian.org/debian-security/ RELEASE-security main contrib non-free non-free-firmware
deb [ arch=armhf ] http://deb.debian.org/debian RELEASE-updates main contrib non-free non-free-firmware

